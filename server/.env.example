# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# Password Reset
RESET_TOKEN_EXPIRES_HOURS=2

# SMTP (leave empty for console preview mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@brightloop.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Business Settings
BUSINESS_NAME=Brightloop Software
BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
